# PostgreSQL — Neon vagy helyi példány
# Neon pooler példa (SSL kötelező):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
#
# Helyi Docker (opcionális, ha nem Neon-t használsz):
# DATABASE_URL=postgres://oktateszt:oktateszt@localhost:5432/oktateszt
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# HTTP szerver
PORT=3000
NODE_ENV=development

# Cookie: élesben legyen true (HTTPS)
COOKIE_SECURE=false

# CORS / Origin ellenőrzés (Vite dev szerver)
FRONTEND_ORIGIN=http://localhost:5173

# Session élettartama másodpercben (alap: 7 nap)
SESSION_TTL_SECONDS=604800

# Fejlesztői tesztfelhasználók: npm run db:seed (backend/)
# Belépési adatok: backend/seed-felhasznalok.local.txt
